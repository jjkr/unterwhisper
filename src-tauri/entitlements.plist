<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow the app to use accessibility features -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    
    <!-- Allow input monitoring for global hotkeys -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    
    <!-- Allow JIT compilation for runtime code generation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    
    <!-- Allow unsigned executable memory for private APIs -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <!-- Disable library validation for third-party libraries -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- Allow DYLD environment variables -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    
    <!-- Allow debugging for development -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
    
    <!-- Network access (if needed for future features) -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- File system access -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- MISSING ENTITLEMENTS FOR CORE GRAPHICS AND ACCESSIBILITY -->
    
    <!-- Allow access to window server for Core Graphics private APIs -->
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
    
    <!-- Allow access to Core Graphics window management -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>com.apple.windowserver.active</string>
        <string>com.apple.CoreGraphics.CGSConnection</string>
    </array>
    
    <!-- Allow access to Accessibility APIs -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    
    <!-- Allow input monitoring (required for gesture simulation) -->
    <key>com.apple.security.device.input-monitoring</key>
    <true/>
    
    <!-- Allow screen recording (may be needed for window management) -->
    <key>com.apple.security.device.screen-recording</key>
    <true/>
    
    <!-- Allow access to system events -->
    <key>com.apple.security.temporary-exception.shared-preference.read-write</key>
    <array>
        <string>com.apple.HIToolbox</string>
        <string>com.apple.universalaccess</string>
    </array>
    
    <!-- Camera access (placeholder for future features) -->
    <key>com.apple.security.device.camera</key>
    <false/>
    
    <!-- Microphone access (placeholder for future features) -->
    <key>com.apple.security.device.microphone</key>
    <false/>
    
    <!-- Location access (placeholder for future features) -->
    <key>com.apple.security.personal-information.location</key>
    <false/>
    
    <!-- Contacts access (placeholder for future features) -->
    <key>com.apple.security.personal-information.addressbook</key>
    <false/>
    
    <!-- Calendar access (placeholder for future features) -->
    <key>com.apple.security.personal-information.calendars</key>
    <false/>
    
    <!-- Photos access (placeholder for future features) -->
    <key>com.apple.security.personal-information.photos-library</key>
    <false/>

    <key>com.apple.security.app-sandbox</key>
    <false/> <!-- You can’t sandbox if you’re calling private CGS APIs -->
    <key>com.apple.security.accessibility</key>
    <true/>  <!-- For AX and event injection APIs -->

</dict>
</plist>
